    "react-component",
    "trading-chart",
    "candlestick-chart",
    "charting-library",
    "stock-chart",
    "typescript",
    "1penny",
    "financial-chart",
    "crypto-chart",
    "indicators",
    "drawing-tools",
    "tradingview-alternative",
    "lightweight-charts-alternative",
    "klinecharts-alternative",
    "react-chart"
  ],
  "homepage": "https://github.com/ducbka02/1penny",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
